{
  "locals": [
    {
      "id": "local-example",
      "name": "Example API",
      "kind": "openai",
      "base_url": "https://api.example.com/v1",
      "env_key": "THIRD_PARTY_API_KEY",
      "wire_api": "responses",
      "models": ["claude-opus-5-5", "claude-sonnet-5-5", "claude-sonnet-4-6"],
      "model_specs": {
        "claude-opus-5-5": {"context_window": 200000, "default_max_output_tokens": 32768},
        "claude-sonnet-5-5": {"context_window": 200000},
        "claude-sonnet-4-6": {"context_window": 200000}
      }
    }
  ]
}
